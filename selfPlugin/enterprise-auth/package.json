{
  "name": "dsh-enterprise-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "nextbos ERP 系统企业身份插件：IM 用户登录、加密 Token 存储与业务接口凭据注入",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "cordis.patch.yml", "README.md", "examples"],
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}},
  "engines": {"node": "^22.19.0 || >=24.0.0"},
  "scripts": {
    "setup": "node scripts/link-harness.mjs",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.2"
  }
}
