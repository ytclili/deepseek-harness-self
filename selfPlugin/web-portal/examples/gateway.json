    "model": "gpt-5.6-sol",
    "runtimeBaseUrl": "http://host.docker.internal:23080/portal/model/v1",
    "maxBodyBytes": 16777216,
    "timeoutMs": 300000,
    "maxConcurrent": 2
  }
