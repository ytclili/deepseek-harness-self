{
  "name": "kaidanba-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Harness 定时商品推送：持久化任务、商品查询及 IM 投递",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "tsc --noEmit && node scripts/build-plugin.mjs",
    "build:preview": "tsc --noEmit && vite build",
    "test": "npm run build && node --experimental-strip-types --test tests/host.test.mjs tests/runtime.test.mjs tests/lifecycle.test.mjs tests/backup.test.mjs",
    "test:client": "npm run build && node --test tests/plugin.test.mjs",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5186 --strictPort"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "antd": "5.29.3",
    "dayjs": "1.11.13",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "6.3.6"
  }
}
